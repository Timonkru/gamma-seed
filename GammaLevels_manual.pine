//@version=5
// Gamma Levels (Manual Input)  [KruegerAlgorithms]
// Funktioniert ohne Pine-Seed-Freischaltung: die 5 Zahlen aus `python build_seed.py` eintippen.
// Zeichnet feste horizontale Level (am aktuellen Bar berechnet) + optional Auto-Umskalierung ETF -> Chart.
indicator("Gamma Levels (Manual) [KruegerAlgorithms]", overlay = true)

g = "Level (aus build_seed.py ablesen)"
flipI  = input.float(0.0, "Gamma Flip (ETF)", group = g)
cwallI = input.float(0.0, "Call Wall (ETF)",  group = g)
pwallI = input.float(0.0, "Put Wall (ETF)",   group = g)
mpainI = input.float(0.0, "Max Pain (ETF)",   group = g)
spotI  = input.float(0.0, "ETF Spot (fuer Umskalierung)", group = g)

g2 = "Anzeige"
rescale = input.bool(true, "Auf Chart-Instrument umskalieren (ETF -> XAUUSD/Futures)", group = g2)
showMP  = input.bool(true, "Max Pain zeigen", group = g2)
showReg = input.bool(true, "Regime-Hintergrund (Spot vs Flip)", group = g2)

// Umrechnung am AKTUELLEN Bar (Index/ETF taggleich), als feste Linien gezeichnet.
k = rescale and spotI > 0 ? close / spotI : 1.0
flip  = flipI  * k
cwall = cwallI * k
pwall = pwallI * k
mpain = mpainI * k

// Regime in ETF-Termini: Spot ueber Flip = long gamma (Pin/Reversion), darunter = short (Trend)
refSpot = rescale and spotI > 0 ? spotI : close
longGamma = flipI > 0 and refSpot > flipI
bgcolor(showReg and flipI > 0 ? (longGamma ? color.new(color.green, 92) : color.new(color.red, 92)) : na)

var line lF = na
var line lC = na
var line lP = na
var line lM = na
var label lab = na
if barstate.islast
    line.delete(lF), line.delete(lC), line.delete(lP), line.delete(lM), label.delete(lab)
    x1 = bar_index - 400
    if flipI > 0
        lF := line.new(x1, flip,  bar_index, flip,  color = color.yellow, width = 2, extend = extend.right)
    if cwallI > 0
        lC := line.new(x1, cwall, bar_index, cwall, color = color.red,    width = 2, extend = extend.right)
    if pwallI > 0
        lP := line.new(x1, pwall, bar_index, pwall, color = color.green,  width = 2, extend = extend.right)
    if showMP and mpainI > 0
        lM := line.new(x1, mpain, bar_index, mpain, color = color.gray,   width = 1, extend = extend.right, style = line.style_dotted)
    if flipI > 0
        txt = (longGamma ? "LONG gamma (Pin/Reversion)" : "SHORT gamma (Trend/Amplify)") + "  Flip " + str.tostring(flip, format.mintick)
        lab := label.new(bar_index, high, txt, style = label.style_label_left, color = longGamma ? color.new(color.green, 20) : color.new(color.red, 20), textcolor = color.white, size = size.small)

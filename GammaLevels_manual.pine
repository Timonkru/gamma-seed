//@version=5
// Gamma Levels (Manual Input)  [KruegerAlgorithms]
// Die Werte aus `python build_seed.py` sind bereits FESTE PREISE in Index-Punkten (CFD-Skala).
// Einfach eintippen -> feste horizontale Linien. Keine Live-Skalierung, kein Wackeln.
indicator("Gamma Levels (Manual) [KruegerAlgorithms]", overlay = true)

g = "Level in Index-Punkten (aus build_seed.py)"
flipI  = input.float(0.0, "Gamma Flip", group = g)
cwI    = input.float(0.0, "Call Wall",  group = g)
pwI    = input.float(0.0, "Put Wall",   group = g)
mpI    = input.float(0.0, "Max Pain",   group = g)
offset = input.float(0.0, "Manueller Offset (Punkte, Broker-Basis)", group = g)

g2 = "Anzeige"
showMP  = input.bool(true, "Max Pain zeigen", group = g2)
showReg = input.bool(true, "Regime-Hintergrund (Kurs vs Flip)", group = g2)

flip = flipI > 0 ? flipI + offset : flipI
cw   = cwI   > 0 ? cwI   + offset : cwI
pw   = pwI   > 0 ? pwI   + offset : pwI
mp   = mpI   > 0 ? mpI   + offset : mpI

longGamma = flip > 0 and close > flip
bgcolor(showReg and flip > 0 ? (longGamma ? color.new(color.green, 92) : color.new(color.red, 92)) : na)

var line lF = na
var line lC = na
var line lP = na
var line lM = na
var label lab = na
if barstate.islast
    line.delete(lF)
    line.delete(lC)
    line.delete(lP)
    line.delete(lM)
    label.delete(lab)
    x1 = bar_index - 400
    if flip > 0
        lF := line.new(x1, flip, bar_index, flip, color = color.yellow, width = 2, extend = extend.right)
    if cw > 0
        lC := line.new(x1, cw,   bar_index, cw,   color = color.red,    width = 2, extend = extend.right)
    if pw > 0
        lP := line.new(x1, pw,   bar_index, pw,   color = color.green,  width = 2, extend = extend.right)
    if showMP and mp > 0
        lM := line.new(x1, mp,   bar_index, mp,   color = color.gray,   width = 1, extend = extend.right, style = line.style_dotted)
    if flip > 0
        txt = (longGamma ? "LONG gamma (Pin/Reversion)" : "SHORT gamma (Trend/Amplify)") + "  Flip " + str.tostring(flip, format.mintick)
        lab := label.new(bar_index, high, txt, style = label.style_label_left, color = longGamma ? color.new(color.green, 20) : color.new(color.red, 20), textcolor = color.white, size = size.small)

//@version=5
// Gamma Levels (Pine Seed)  [KruegerAlgorithms]
// Liest taeglich aktualisierte Gamma-Level aus deinem oeffentlichen GitHub-Seed-Repo via request.seed().
// Zeichnet Gamma-Flip, Call-Wall, Put-Wall, Max-Pain und faerbt das Regime (ueber/unter Flip).
// Quelle wird von TradingView nach Freischaltung als "seed_<githubuser>_<repo>" angesprochen.
indicator("Gamma Levels (Seed) [KruegerAlgorithms]", overlay = true)

// ---- Inputs ----
src    = input.string("seed_Timonkru_gamma-seed", "Seed-Quelle (seed_<githubuser>_<repo>)")
prefix = input.string("GOLD", "Index-Prefix", options = ["NQ", "DOW", "GOLD", "DAX", "FTSE"])
showRegime = input.bool(true, "Regime-Hintergrund (ueber/unter Flip)")
showMaxPain = input.bool(true, "Max-Pain zeigen")
rescale = input.bool(true, "Auf Chart-Instrument umskalieren (ETF -> z.B. XAUUSD/Futures)")

f_(metric) => request.seed(src, prefix + "_" + metric, close, ignore_invalid_symbol = true)

spotEtf = f_("SPOT")
// Skalierungsfaktor: Chart-Preis / ETF-Spot (legt ETF-Level auf die Skala des gehandelten Instruments)
k = rescale and not na(spotEtf) and spotEtf > 0 ? close / spotEtf : 1.0

flip   = f_("FLIP")   * k
cwall  = f_("CWALL")  * k
pwall  = f_("PWALL")  * k
mpain  = f_("MAXPAIN") * k
gexbn  = f_("GEXBN")

p_flip  = plot(flip,  "Gamma Flip", color = color.yellow,       linewidth = 2, style = plot.style_linebr)
p_cwall = plot(cwall, "Call Wall",  color = color.red,          linewidth = 2, style = plot.style_linebr)
p_pwall = plot(pwall, "Put Wall",   color = color.green,        linewidth = 2, style = plot.style_linebr)
plot(showMaxPain ? mpain : na, "Max Pain", color = color.gray, linewidth = 1, style = plot.style_circles)

// Regime: Spot ueber Flip = long gamma (Reversion/Pin), darunter = short gamma (Trend/Amplify)
longGamma = not na(flip) and close > flip
bgcolor(showRegime ? (longGamma ? color.new(color.green, 92) : color.new(color.red, 92)) : na)

// Label rechts mit Regime + Netto-GEX
var label lab = na
if barstate.islast and not na(flip)
    label.delete(lab)
    txt = (longGamma ? "LONG gamma (Pin/Reversion)" : "SHORT gamma (Trend/Amplify)") + "\nFlip " + str.tostring(flip, "#.#") + "  GEX " + str.tostring(gexbn, "#.##") + "bn"
    lab := label.new(bar_index, high, txt, style = label.style_label_left, color = longGamma ? color.new(color.green, 20) : color.new(color.red, 20), textcolor = color.white, size = size.small)

alertcondition(ta.cross(close, flip), "Gamma flip crossed", "Spot hat den Gamma-Flip gekreuzt (Regime-Wechsel).")
